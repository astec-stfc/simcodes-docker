# Two stages: `build` compiles everything; the final image gets only what the codes need at run time (their
# install trees and the shared libraries they link), not the compilers, the sources or the build trees.
FROM almalinux/9-minimal AS build

WORKDIR /simcodes

#########################################################################
# Requirements
#########################################################################
RUN microdnf install wget dnf -y && microdnf clean all

RUN dnf install epel-release -y -q && \
    dnf config-manager --set-enabled crb

RUN dnf group install "Development Tools" -y -q

RUN dnf install cmake git gsl-devel fftw-devel lapack lapack-devel blas blas-devel gfortran mpich mpich-devel openmpi openmpi-devel hdf5 hdf5-devel hdf5-openmpi hdf5-openmpi-devel boost-devel libtiff libtiff-devel gd gd-devel mold -y -q

# openmpi/hdf5-openmpi install under a non-default prefix (EL9 "environment modules" layout)
ENV PATH=/usr/lib64/openmpi/bin:$PATH
ENV LD_LIBRARY_PATH=/usr/lib64/openmpi/lib
ENV CPATH=/usr/include/openmpi-x86_64

#########################################################################
# Elegant
#########################################################################
RUN git clone https://github.com/rtsoliday/SDDS.git &&\
    cd SDDS &&\
    make -j4

RUN git clone https://github.com/rtsoliday/elegant.git &&\
    cd elegant &&\
    git checkout elegant-2026.4.0 &&\
    export MPI_PATH=/usr/lib64/openmpi && \
    export USE_MPI=1 &&\
    make -j1

ENV RPN_DEFNS=/simcodes/SDDS/defns.rpn

#########################################################################
# ASTRA and CSRTrack come from DESY's user pages, which are down at times
#########################################################################
# fetch-desy downloads a file and keeps the download only if its sha256 is the one in vendor/desy/SHA256SUMS; if DESY does
# not answer, or answers with another file, it uses the known-good copy in vendor/desy and says so in the build log.
# --build-arg FETCH_DESY_SKIP=1 does not try DESY at all.
COPY vendor/desy /vendor/desy
COPY .github/docker/fetch-desy.sh /usr/local/bin/fetch-desy
ARG FETCH_DESY_SKIP=0
RUN chmod +x /usr/local/bin/fetch-desy

#########################################################################
# ASTRA (single code and parallel)
#########################################################################

RUN mkdir Astra-serial &&\
    cd Astra-serial &&\
    fetch-desy astra-serial/Astra https://www.desy.de/~mpyflo/Astra_for_64_Bit_Linux/Astra && \
    fetch-desy astra-serial/generator https://www.desy.de/~mpyflo/Astra_for_64_Bit_Linux/generator && \
    chmod +x Astra generator

RUN mkdir Astra-parallel && \
    cd Astra-parallel && \
    fetch-desy astra-parallel/Astra https://www.desy.de/~mpyflo/Parallel_Astra_for_Linux/Astra && \
    chmod +x Astra Astra

#########################################################################
# OpenMPI 4.0.3 (needed for Astra)
#########################################################################
RUN wget --no-verbose https://download.open-mpi.org/release/open-mpi/v4.0/openmpi-4.0.3.tar.gz && \
    tar zxf openmpi-4.0.3.tar.gz && \
    mkdir openmpi-4.0.3-install && \ 
    cd openmpi-4.0.3 && \
    ./configure --prefix=/simcodes/openmpi-4.0.3-install && \
    make -j4 install && \
    cd /simcodes/openmpi-4.0.3-install/lib && \
    ln -s libmpi_usempi_ignore_tkr.so libmpi_usempi.so.40 && \
    rm -rf openmpi-4.0.3.tar.gz && \
    rm -rf openmpi-4.0.3
ENV LD_LIBRARY_PATH=/simcodes/openmpi-4.0.3-install/lib/:/usr/lib64/openmpi/lib:/usr/local/lib

#########################################################################
# CSRTRack
#########################################################################

RUN mkdir CSRTrack-serial && \
    cd CSRTrack-serial && \
    fetch-desy csrtrack-serial/csrtrack_1.204_Linux_x86_64_serial https://www.desy.de/xfel-beam/csrtrack/files/csrtrack_1.204_Linux_x86_64_serial && \
    chmod +x csrtrack_1.204_Linux_x86_64_serial

RUN mkdir CSRTrack-parallel && \
    cd CSRTrack-parallel && \
    fetch-desy csrtrack-parallel/csrtrack_1.204_Linux_x86_64_OpenMPI_1.4.3 https://www.desy.de/xfel-beam/csrtrack/files/csrtrack_1.204_Linux_x86_64_OpenMPI_1.4.3 && \
    chmod +x csrtrack_1.204_Linux_x86_64_OpenMPI_1.4.3

#########################################################################
# OPAL
#########################################################################
# Built against the from-source OpenMPI 4.0.3 (above), not the distro openmpi
# package: EL9's openmpi+pmix RPM combo segfaults/fails MPI_Init at runtime
# (a distro packaging bug, reproducible even with a trivial MPI program), so
# anything that needs to actually run MPI code must avoid it.
#
# NOTE: do not name these OMPI_CC/OMPI_CXX/OMPI_FC - those are reserved
# env vars that OpenMPI's own mpicc/mpicxx/mpifort wrappers read at runtime
# to pick their underlying compiler. Pointing them at mpicc itself makes
# every invocation of mpicc re-invoke mpicc, forever (a fork bomb).
ENV MPICC_BIN=/simcodes/openmpi-4.0.3-install/bin/mpicc
ENV MPICXX_BIN=/simcodes/openmpi-4.0.3-install/bin/mpicxx
ENV MPIFC_BIN=/simcodes/openmpi-4.0.3-install/bin/mpifort

RUN git clone https://github.com/eth-cscs/h5hut.git && \
    cd h5hut && \
    ./autogen.sh && \
    CC=$MPICC_BIN CXX=$MPICXX_BIN ./configure --prefix=/usr/local/ --enable-parallel --with-pic && \
    make -j4 -C src install

RUN git clone https://github.com/OPALX-project/OPAL.git && \
    cd OPAL && \
    git checkout OPAL-2024.1.0 && \
    mkdir -p /simcodes/OPAL-build && \
    cd /simcodes/OPAL-build && \
    CC=$MPICC_BIN CXX=$MPICXX_BIN FC=$MPIFC_BIN cmake \
        -DCMAKE_INSTALL_PREFIX=/simcodes/OPAL-install \
        -DCMAKE_BUILD_TYPE=RELEASE \
        -DHDF5_ROOT=/usr/lib64/openmpi \
        -DWILL_BUILD_SHARED_LIBRARY=ON \
        -DCMAKE_CXX_FLAGS=-DOMPI_SKIP_MPICXX \
        "-DCMAKE_EXE_LINKER_FLAGS=-L/simcodes/openmpi-4.0.3-install/lib -lopen-pal -lopen-rte" \
        -DENABLE_AMR=OFF \
        -DENABLE_AMR_MG_SOLVER=OFF \
        -DENABLE_SAAMG_SOLVER=OFF \
        -DENABLE_OPAL_FEL=OFF \
        -DBUILD_OPAL_UNIT_TESTS=OFF \
        /simcodes/OPAL && \
    make -j4 && \
    make install

#########################################################################
# Ptarmigan (Rust), in a stage of its own so that it does not touch the build above
#########################################################################
# serial, with HDF5 (SIMBA writes its beam to, and reads the result from, HDF5 files); the git checkout is needed,
# its build script asks git for the version
FROM almalinux/9-minimal AS ptarmigan
ARG PTARMIGAN_VERSION=v1.6.1
RUN microdnf install wget dnf -y && microdnf clean all && \
    dnf install epel-release -y -q && \
    dnf install -y -q git cargo gcc hdf5-devel && \
    git clone --depth 1 --branch "$PTARMIGAN_VERSION" https://github.com/tgblackburn/ptarmigan.git /tmp/ptarmigan && \
    cd /tmp/ptarmigan && \
    cargo build --release --features hdf5-output -j4 && \
    install -D target/release/ptarmigan /simcodes/Ptarmigan/ptarmigan

#########################################################################
#########################################################################
# The image: run-time libraries, the installed codes, and conda
#########################################################################
#########################################################################
FROM almalinux/9-minimal

ENTRYPOINT ["/bin/bash"]
WORKDIR /simcodes

# the shared libraries the compiled codes link (checked by the ldd gate below; mpich is Pelegant's MPI, libibverbs
# and librdmacm are for OpenMPI's plugins); OpenMPI 4 will not start even a local run without an ssh client; gcc is
# for Xsuite, which compiles its C kernels at run time.
# hdf5-openmpi, not hdf5: the serial library has the same soname, so ldd is happy with it, but H5hut (in OPAL) then
# lacks H5Pset_fapl_mpio and OPAL dies at its first write.  Its libmpi.so.40 resolves to OpenMPI 4.0.3 (first on
# LD_LIBRARY_PATH), not to the distro OpenMPI it pulls in (see the OPAL note in the build stage).
RUN microdnf install wget dnf -y && microdnf clean all && \
    dnf install epel-release -y -q && \
    dnf config-manager --set-enabled crb && \
    dnf install -y -q \
        blas lapack fftw-libs-double libgfortran libgomp libquadmath gsl hdf5-openmpi mpich libibverbs librdmacm \
        boost-chrono boost-filesystem boost-iostreams boost-regex boost-serialization boost-system boost-timer \
        openssh-clients gcc && \
    dnf clean all

ENV LD_LIBRARY_PATH=/simcodes/openmpi-4.0.3-install/lib/:/usr/lib64/openmpi/lib:/usr/local/lib
ENV RPN_DEFNS=/simcodes/SDDS/defns.rpn

COPY --from=build /simcodes/SDDS/defns.rpn /simcodes/SDDS/defns.rpn
COPY --from=build /simcodes/elegant/bin/Linux-x86_64 /simcodes/elegant/bin/Linux-x86_64
COPY --from=build /simcodes/Astra-serial /simcodes/Astra-serial
COPY --from=build /simcodes/Astra-parallel /simcodes/Astra-parallel
COPY --from=build /simcodes/CSRTrack-serial /simcodes/CSRTrack-serial
COPY --from=build /simcodes/CSRTrack-parallel /simcodes/CSRTrack-parallel
COPY --from=build /simcodes/openmpi-4.0.3-install /simcodes/openmpi-4.0.3-install
COPY --from=build /simcodes/OPAL-install /simcodes/OPAL-install
COPY --from=build /usr/local/lib /usr/local/lib
COPY --from=ptarmigan /simcodes/Ptarmigan /simcodes/Ptarmigan

#########################################################################
# Download and install Miniconda
#########################################################################
RUN wget --no-verbose https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /tmp/miniconda.sh && \
    bash /tmp/miniconda.sh -b -p /opt/conda && \
    rm /tmp/miniconda.sh

# Add conda to PATH
ENV PATH=/opt/conda/bin:$PATH
# Last on LD_LIBRARY_PATH for Python: a pip wheel (torch, ...) has no RPATH to conda's libstdc++, so without this it
# loads the system's older one first, and conda's h5py, which needs the newer one, then fails to import.  (Nothing
# compiled above needs it: Astra-parallel links no HDF5, and the conda programs find their own libraries by RPATH.)
ENV LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/opt/conda/lib

# Initialise conda
RUN conda init bash 
##    conda update -n base -c defaults conda -y && \
##    conda clean -afy

# Accept conda ToS
RUN conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main && \
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r

#########################################################################
# BMAD
#########################################################################
# conda clean: the downloaded package tarballs would otherwise stay in the image
RUN conda install ipython numpy h5py pydantic bmad pytao -c conda-forge -y --quiet && \
    conda clean -afy

#########################################################################
# Genesis
#########################################################################
RUN conda install genesis4=4.6.16 -c conda-forge -y --quiet && \
    conda clean -afy && \
    mkdir -p /simcodes/Genesis && \
    ln -s /opt/conda/bin/genesis4 /simcodes/Genesis/genesis4

#########################################################################
# ImpactX (a Python module, so next to SIMBA) and HiPACE++ (a program, in an environment of its own: it is built
# against another AMReX than ImpactX)
#########################################################################
# nompi: SIMBA runs ImpactX in its own process.  conda-forge builds both for x86-64-v3 (AVX2) CPUs.
RUN conda install "impactx=26.10=nompi*" -c conda-forge -y --quiet && \
    conda create -n hipace "hipace=26.05" -c conda-forge -y --quiet && \
    conda clean -afy && \
    mkdir -p /simcodes/HiPACE && \
    ln -s /opt/conda/envs/hipace/bin/hipace.NOMPI.OMP.DP.LF /simcodes/HiPACE/hipace

#########################################################################
# SIMBA and the Python simulation codes
#########################################################################
# SIMBA's own `simcodes` and `fbpic` extras (Ocelot, Xsuite, Cheetah, Wake-T, cpymad, FBPIC, ...), so the image has
# the versions SIMBA asks for, and SIMBA itself for running inside the image.  The latest release by default; e.g.
# --build-arg SIMBA_SPEC="simba-accelerator[simcodes,fbpic]==0.7.2", or a git URL, for another.  Then Slipstream
# (a GitHub release, not on PyPI).  FBPIC runs on the CPU here (a GPU needs cupy).
# RF-Track is not here: its licence (CERN proprietary, free to use) does not say it may be redistributed, so users
# `pip install RF_Track` themselves.
# Cheetah and Slipstream need torch, and torch from PyPI brings the CUDA libraries (several GB); the image runs on
# CPUs, so the CPU build goes in first and pip keeps it.
ARG SIMBA_SPEC="simba-accelerator[simcodes,fbpic]"
ARG SLIPSTREAM_VERSION=v1.1.0
RUN /opt/conda/bin/pip install --no-cache-dir --quiet torch --index-url https://download.pytorch.org/whl/cpu && \
    /opt/conda/bin/pip install --no-cache-dir --quiet "$SIMBA_SPEC" \
        "slipstream-accel @ https://github.com/astec-stfc/slipstream/archive/refs/tags/${SLIPSTREAM_VERSION}.tar.gz"

#########################################################################
# Verify every code/package installed above is actually usable
#########################################################################
# Note: CSRTrack-parallel is linked against OpenMPI 1.4.3 (soname libmpi.so.0),
# an ABI no longer available on any current distro; it isn't wired into SIMBA's
# docker/apptainer Executables.yaml (only serial CSRTrack is), so it's kept for
# reference but excluded from this executability gate.
# ldd is given the real file: the conda programs are linked here, and their RPATH ($ORIGIN/../lib) is relative to the
# real file, as it is when they run, but ldd would take it relative to the link.
RUN set -e; \
    for f in \
        /simcodes/Astra-serial/Astra /simcodes/Astra-serial/generator /simcodes/Astra-parallel/Astra \
        /simcodes/CSRTrack-serial/csrtrack_1.204_Linux_x86_64_serial \
        /simcodes/elegant/bin/Linux-x86_64/elegant /simcodes/elegant/bin/Linux-x86_64/Pelegant \
        /simcodes/OPAL-install/bin/opal /simcodes/Genesis/genesis4 /simcodes/HiPACE/hipace /simcodes/Ptarmigan/ptarmigan; \
    do \
        test -x "$f" || { echo "NOT EXECUTABLE: $f"; exit 1; }; \
        r=$(readlink -f "$f"); \
        if ldd -r "$r" 2>&1 | grep -qE "not found|undefined symbol"; then \
            echo "MISSING SHARED LIBRARIES OR SYMBOLS for $f:"; ldd -r "$r"; exit 1; \
        fi; \
    done; \
    echo "All simulation code binaries present, executable, and fully linked"

RUN /opt/conda/bin/python3 -c "\
import ocelot, xsuite, cheetah, wake_t, cpymad, torch, impactx, fbpic, slipstream, importlib.metadata as md, simba.Framework; \
assert not torch.cuda.is_available() and '+cpu' in torch.__version__, torch.__version__; \
print('simba', md.version('simba-accelerator')); \
print('impactx', md.version('impactx'), 'fbpic', md.version('fbpic'), 'slipstream', md.version('slipstream-accel')); \
print('ocelot', ocelot.__version__); \
print('xsuite', xsuite.__version__); \
print('cheetah', cheetah.__version__); \
print('wake_t OK'); \
print('cpymad', cpymad.__version__)"

#########################################################################
# SIMBA layout: SIMBA can run inside this image with `simcodes=/simba-codes` and no container runtime
#########################################################################
# SIMBA looks for its codes under <simcodes>/<NAME>/ (the `posix` section of its Executables.yaml); the codes above
# are built under other names, so the directories SIMBA expects are links to them.  `elegant` and `Pelegant` are
# looked up on PATH, and so are `ptarmigan` and `hipace`.  The OPAL profile script that SIMBA sources has nothing to
# set: the image has the environment.
RUN mkdir -p /simba-codes/OPAL/bin /simba-codes/OPAL/etc/profile.d && \
    ln -s /simcodes/Astra-serial /simba-codes/ASTRA && \
    ln -s /simcodes/CSRTrack-serial /simba-codes/CSRTrack && \
    ln -s /simcodes/Genesis /simba-codes/Genesis && \
    ln -s /opt/conda /simba-codes/Bmad && \
    ln -s /simcodes/OPAL-install/bin/opal /simba-codes/OPAL/bin/opal && \
    echo "# nothing to set: the image has the environment" > /simba-codes/OPAL/etc/profile.d/opal.sh && \
    ln -s /simcodes/elegant/bin/Linux-x86_64/elegant /usr/local/bin/elegant && \
    ln -s /simcodes/elegant/bin/Linux-x86_64/Pelegant /usr/local/bin/Pelegant && \
    ln -s /simcodes/Ptarmigan/ptarmigan /usr/local/bin/ptarmigan && \
    ln -s /simcodes/HiPACE/hipace /usr/local/bin/hipace
ENV SIMCODES=/simba-codes
ENV TAO_DIR=/opt/conda/share/doc/tao/

#########################################################################
# Xwindows path
#########################################################################
ENV DISPLAY=host.docker.internal:0.0

# numba (Wake-T, FBPIC) caches its JIT next to the source, and Slipstream sets up torch's compile cache in ~/.cache:
# neither is writable by a user without a home (`docker run --user`).  Last, so no build step creates them as root.
ENV NUMBA_CACHE_DIR=/tmp/numba-cache
ENV TORCHINDUCTOR_CACHE_DIR=/tmp/torch-cache/inductor
ENV TRITON_CACHE_DIR=/tmp/torch-cache/triton
